generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Auth.js (NextAuth v5) Prisma adapter models
// ============================================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  passwordHash  String?   @map("password_hash")
  // Authorisation tier. SUPERUSER can manage other users (create / edit /
  // reset password / delete) via /admin/users. USER is the default.
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts     Account[]
  sessions     Session[]
  auditActions AuditAction[]
  memberships  OrganizationMembership[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================================
// Authorisation & multi-organisation
// ============================================================================

enum UserRole {
  USER
  SUPERUSER
}

enum OrgRole {
  OWNER
  MEMBER
}

// One row per tenant. Users belong to one or more orgs via
// OrganizationMembership; the active org is tracked via a cookie and
// auto-applied by the Prisma client extension in src/lib/prisma.ts.
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  memberships  OrganizationMembership[]
  auditActions AuditAction[]
  instruments  Instrument[]
  candles      Candle[]
  strategies   Strategy[]
  signals      Signal[]
  backtests    Backtest[]
  accounts     Account_[]
  positions    Position[]
  orders       Order_[]
  analyses     AiAnalysis[]
  webhookEndpoint WebhookEndpoint?
  webhookAlerts   WebhookAlert[]

  @@map("organizations")
}

model OrganizationMembership {
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  role           OrgRole  @default(MEMBER)
  joinedAt       DateTime @default(now()) @map("joined_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
  @@index([organizationId])
  @@map("organization_memberships")
}

// ============================================================================
// Settings
// ============================================================================

model Setting {
  id            String @id @default("singleton") // single-row table
  appName       String @default("Kronos") @map("app_name")
  defaultLocale String @default("en") @map("default_locale")

  @@map("settings")
}

// ============================================================================
// Kronos — market data, strategies, backtests, portfolio, paper trading
// ============================================================================
//
// Every model here is tenant data and is listed in ORG_SCOPED_MODELS in
// src/lib/prisma.ts. `organizationId` is `String?` in this schema so call sites
// can rely on the client extension to stamp it, but the migration sets the
// column NOT NULL so an unscoped write fails loudly instead of orphaning a row.
//
// Because the extension injects `organizationId` into `where`, always use
// `findFirst` rather than `findUnique` on these models.
//
// Naming note: `Account` and `Order` are taken by the Auth.js adapter and by a
// SQL reserved word respectively, so the Prisma models are `Account_` / `Order_`
// mapped onto the `trading_accounts` / `orders` tables.

enum AssetClass {
  EQUITY
  CRYPTO
  FX
  COMMODITY
  INDEX
}

enum Timeframe {
  D1
  H1
  M15
}

enum StrategyKind {
  SMA_CROSSOVER
  RSI_REVERSION
  DONCHIAN_BREAKOUT
  MACD_TREND
}

enum SignalSide {
  BUY
  SELL
  FLAT
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
}

enum OrderStatus {
  PENDING
  FILLED
  CANCELLED
  REJECTED
}

/// A tradable symbol. Prices hang off this.
model Instrument {
  id             String     @id @default(cuid())
  organizationId String?    @map("organization_id")
  symbol         String
  name           String
  assetClass     AssetClass @default(EQUITY) @map("asset_class")
  exchange       String?
  currency       String     @default("USD")
  /// Whether this symbol appears on the signals watchlist.
  watched        Boolean    @default(true)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candles      Candle[]
  signals      Signal[]
  backtests    Backtest[]
  positions    Position[]
  orders       Order_[]
  analyses     AiAnalysis[]

  @@unique([organizationId, symbol])
  @@index([organizationId])
  @@map("instruments")
}

/// One OHLCV bar. `ts` is the bar's opening instant, always UTC.
model Candle {
  id             String    @id @default(cuid())
  organizationId String?   @map("organization_id")
  instrumentId   String    @map("instrument_id")
  timeframe      Timeframe @default(D1)
  ts             DateTime
  open           Float
  high           Float
  low            Float
  close          Float
  volume         Float     @default(0)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instrument   Instrument    @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([instrumentId, timeframe, ts])
  @@index([organizationId])
  @@index([instrumentId, timeframe, ts])
  @@map("candles")
}

/// A configured strategy instance: a kind plus its parameters.
model Strategy {
  id             String       @id @default(cuid())
  organizationId String?      @map("organization_id")
  name           String
  kind           StrategyKind
  /// Parameter bag validated per-kind by the zod schemas in src/lib/strategies.ts.
  params         Json
  notes          String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  signals      Signal[]
  backtests    Backtest[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("strategies")
}

/// The most recent evaluation of one strategy against one instrument.
model Signal {
  id             String     @id @default(cuid())
  organizationId String?    @map("organization_id")
  instrumentId   String     @map("instrument_id")
  strategyId     String     @map("strategy_id")
  ts             DateTime
  side           SignalSide
  /// 0..1 conviction, derived from how far the triggering condition is exceeded.
  strength       Float      @default(0)
  price          Float
  reason         String
  createdAt      DateTime   @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instrument   Instrument    @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  strategy     Strategy      @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@unique([instrumentId, strategyId, ts])
  @@index([organizationId])
  @@index([instrumentId, ts])
  @@map("signals")
}

/// A completed backtest run. Metrics are stored denormalised so the list view
/// doesn't have to recompute an equity curve per row.
model Backtest {
  id             String   @id @default(cuid())
  organizationId String?  @map("organization_id")
  instrumentId   String   @map("instrument_id")
  strategyId     String   @map("strategy_id")
  /// The IN-SAMPLE window. The out-of-sample holdout is the oos* fields below;
  /// headline metrics on this row describe the in-sample period only.
  from           DateTime
  to             DateTime
  initialCash    Float    @map("initial_cash")
  commissionBps  Float    @default(0) @map("commission_bps")
  slippageBps    Float    @default(0) @map("slippage_bps")
  finalEquity    Float    @map("final_equity")
  totalReturnPct Float    @map("total_return_pct")
  cagrPct        Float    @map("cagr_pct")
  maxDrawdownPct Float    @map("max_drawdown_pct")
  sharpe         Float
  winRatePct     Float    @map("win_rate_pct")
  profitFactor   Float    @map("profit_factor")
  tradeCount     Int      @map("trade_count")
  /// Equity curve points, for the detail chart.
  equityCurve    Json     @map("equity_curve")

  // --- Validation ---------------------------------------------------------
  // A backtest is not a result until it has survived a holdout and a
  // walk-forward. These are denormalised so the list view can show the verdict
  // without recomputing anything.
  accepted           Boolean   @default(false)
  verdictSummary     String    @default("") @map("verdict_summary")
  /// Every reason the run was rejected, each tagged with its gate.
  failures           Json      @default("[]")
  oosFrom            DateTime? @map("oos_from")
  oosTo              DateTime? @map("oos_to")
  oosReturnPct       Float     @default(0) @map("oos_return_pct")
  oosSharpe          Float     @default(0) @map("oos_sharpe")
  oosMaxDrawdownPct  Float     @default(0) @map("oos_max_drawdown_pct")
  oosTradeCount      Int       @default(0) @map("oos_trade_count")
  oosWinRatePct      Float     @default(0) @map("oos_win_rate_pct")
  walkForwardPassed  Boolean   @default(false) @map("walk_forward_passed")
  walkForwardReason  String    @default("") @map("walk_forward_reason")
  /// One row per walk-forward window, for the detail table.
  walkForwardWindows Json      @default("[]") @map("walk_forward_windows")

  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instrument   Instrument      @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  strategy     Strategy        @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  trades       BacktestTrade[]

  @@index([organizationId])
  @@index([instrumentId, createdAt])
  @@map("backtests")
}

/// A single round-trip inside a backtest. Child of Backtest, reached only
/// through its scoped parent, so it carries no organizationId of its own.
model BacktestTrade {
  id         String    @id @default(cuid())
  backtestId String    @map("backtest_id")
  side       OrderSide
  quantity   Float
  entryTs    DateTime  @map("entry_ts")
  entryPrice Float     @map("entry_price")
  exitTs     DateTime? @map("exit_ts")
  exitPrice  Float?    @map("exit_price")
  pnl        Float     @default(0)
  returnPct  Float     @default(0) @map("return_pct")
  exitReason String?   @map("exit_reason")

  backtest Backtest @relation(fields: [backtestId], references: [id], onDelete: Cascade)

  @@index([backtestId, entryTs])
  @@map("backtest_trades")
}

/// A paper-trading account. Named `Account_` because Auth.js owns `Account`.
model Account_ {
  id             String   @id @default(cuid())
  organizationId String?  @map("organization_id")
  name           String
  currency       String   @default("USD")
  startingCash   Float    @map("starting_cash")
  cash           Float
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  positions    Position[]
  orders       Order_[]
  webhookEndpoints WebhookEndpoint[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("trading_accounts")
}

/// Net holding of one instrument in one account, on an average-cost basis.
/// A short position is a negative `quantity`.
model Position {
  id             String   @id @default(cuid())
  organizationId String?  @map("organization_id")
  accountId      String   @map("account_id")
  instrumentId   String   @map("instrument_id")
  quantity       Float    @default(0)
  avgCost        Float    @default(0) @map("avg_cost")
  realizedPnl    Float    @default(0) @map("realized_pnl")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      Account_      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  instrument   Instrument    @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([accountId, instrumentId])
  @@index([organizationId])
  @@map("positions")
}

/// A paper order. Named `Order_` because `order` is a SQL reserved word.
model Order_ {
  id             String      @id @default(cuid())
  organizationId String?     @map("organization_id")
  accountId      String      @map("account_id")
  instrumentId   String      @map("instrument_id")
  side           OrderSide
  type           OrderType   @default(MARKET)
  quantity       Float
  limitPrice     Float?      @map("limit_price")
  status         OrderStatus @default(PENDING)
  filledPrice    Float?      @map("filled_price")
  filledAt       DateTime?   @map("filled_at")
  /// Why a PENDING order has not filled, or why one was rejected.
  note           String?
  placedAt       DateTime    @default(now()) @map("placed_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      Account_      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  instrument   Instrument    @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([accountId, placedAt])
  @@index([status])
  @@map("orders")
}

/// A written analysis of an instrument. `model` records which engine produced
/// it — an Anthropic model id, or "rule-based" for the offline fallback.
model AiAnalysis {
  id             String   @id @default(cuid())
  organizationId String?  @map("organization_id")
  instrumentId   String   @map("instrument_id")
  model          String
  headline       String
  content        String
  /// The indicator snapshot the analysis was written from, for auditability.
  context        Json
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instrument   Instrument    @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([instrumentId, createdAt])
  @@map("ai_analyses")
}

// ============================================================================
// Audit
// ============================================================================

model AuditAction {
  id             String    @id @default(cuid())
  organizationId String?   @map("organization_id")
  type           String
  entityType     String    @map("entity_type")
  entityId       String    @map("entity_id")
  userId         String?   @map("user_id")
  description    String
  payload        Json
  undone         Boolean   @default(false)
  undoneAt       DateTime? @map("undone_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
  @@index([undone, createdAt])
  @@map("audit_actions")
}

// ---------------------------------------------------------------------------
// TradingView integration
// ---------------------------------------------------------------------------

enum AlertStatus {
  /// Accepted and turned into a paper order.
  FILLED
  /// Understood, but no order was needed (already at the target position).
  IGNORED
  /// Well-formed but not actionable — unknown symbol, no price, endpoint off.
  REJECTED
  /// Could not be parsed, or the secret did not match.
  INVALID
}

/// Per-organisation TradingView receiver. One endpoint per org: the URL carries
/// the org id and the shared secret travels in the alert body, because
/// TradingView cannot send custom headers.
model WebhookEndpoint {
  id             String  @id @default(cuid())
  organizationId String  @unique @map("organization_id")
  /// Shared secret. Compared in constant time against the alert payload.
  secret         String
  /// Where fills land. Alerts are rejected while this is unset.
  accountId      String? @map("account_id")
  enabled        Boolean @default(true)
  /// Currency notional per signal; quantity is notional / price.
  notionalPerTrade Float @default(1000) @map("notional_per_trade")
  slippageBps    Float   @default(2) @map("slippage_bps")
  commissionBps  Float   @default(5) @map("commission_bps")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      Account_?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  alerts       WebhookAlert[]

  @@map("webhook_endpoints")
}

/// Every inbound alert, kept whether or not it traded. The raw body is stored
/// verbatim: when a TradingView alert misfires at 3am the only useful evidence
/// is what was actually posted, not our interpretation of it.
model WebhookAlert {
  id             String      @id @default(cuid())
  organizationId String?     @map("organization_id")
  endpointId     String?     @map("endpoint_id")
  /// Exactly what TradingView posted, before parsing.
  raw            Json
  symbol         String      @default("")
  action         String      @default("")
  price          Float?
  strategyName   String?     @map("strategy_name")
  status         AlertStatus @default(REJECTED)
  /// Why it was ignored or rejected, in plain language.
  note           String?
  /// The paper order this alert produced, if any.
  orderId        String?     @map("order_id")
  receivedAt     DateTime    @default(now()) @map("received_at")

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  endpoint     WebhookEndpoint? @relation(fields: [endpointId], references: [id], onDelete: SetNull)

  @@index([organizationId, receivedAt])
  @@map("webhook_alerts")
}
