generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Auth.js (NextAuth v5) Prisma adapter models
// ============================================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  passwordHash  String?   @map("password_hash")
  // Authorisation tier. SUPERUSER can manage other users (create / edit /
  // reset password / delete) via /admin/users. USER is the default.
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts     Account[]
  sessions     Session[]
  auditActions AuditAction[]
  memberships  OrganizationMembership[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================================
// Authorisation & multi-organisation
// ============================================================================

enum UserRole {
  USER
  SUPERUSER
}

enum OrgRole {
  OWNER
  MEMBER
}

// One row per tenant. Users belong to one or more orgs via
// OrganizationMembership; the active org is tracked via a cookie and
// auto-applied by the Prisma client extension in src/lib/prisma.ts.
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  memberships  OrganizationMembership[]
  auditActions AuditAction[]

  @@map("organizations")
}

model OrganizationMembership {
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  role           OrgRole  @default(MEMBER)
  joinedAt       DateTime @default(now()) @map("joined_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
  @@index([organizationId])
  @@map("organization_memberships")
}

// ============================================================================
// Settings
// ============================================================================

model Setting {
  id            String @id @default("singleton") // single-row table
  appName       String @default("Newproject") @map("app_name")
  defaultLocale String @default("en") @map("default_locale")

  @@map("settings")
}

// ============================================================================
// Audit
// ============================================================================

model AuditAction {
  id             String    @id @default(cuid())
  organizationId String?   @map("organization_id")
  type           String
  entityType     String    @map("entity_type")
  entityId       String    @map("entity_id")
  userId         String?   @map("user_id")
  description    String
  payload        Json
  undone         Boolean   @default(false)
  undoneAt       DateTime? @map("undone_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
  @@index([undone, createdAt])
  @@map("audit_actions")
}
