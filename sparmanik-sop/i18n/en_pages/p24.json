{
"id": 11,
"lines": [
[
"Set the timer ",
"ONCE",
" on Day 25. Leave it until Day 42."
]
],
"spaced": false
},
{
"id": 12,
"lines": [
[
"Do NOT change the timer because it rained — the coir drains itself."
]
],
"spaced": false
},
{
"id": 13,
"lines": [
[
"Never water at night. All pulses in daylight."
]
],
"spaced": false
},
{
"id": 14,
"lines": [
[
