{"id": 0, "lines": [["REFERENSI"], ["Denah & ID tanaman"]]},
{"id": 1, "lines": [["Greenhouse 1 — Rumah Produksi Utama dijalankan sebagai ", "fasilitas produksi & pemuliaan", ":"]]},
{"id": 2, "lines": [["tiap baris, polybag, dan tanaman punya ID unik agar tiap tanaman bisa dilacak dari benih"]]},
{"id": 3, "lines": [["sampai panen."]]},
{"id": 4, "lines": [["Denah & aturan"]]},
{"id": 5, "lines": [["10 baris A–J", ", bernomor ", "Selatan ", "→", " Utara", "; polybag ", "01–43 Timur ", "→", " Barat", " per baris."]]},
{"id": 6, "lines": [["43 polybag per baris · 2 tanaman per polybag ", "→", "430 polybag, 860 tanaman", " total."]]},
{"id": 7, "lines": [["Satu buah per tanaman", " — jadi 2 buah per polybag, tiap buah di tanamannya sendiri."]]},
{"id": 8, "lines": [["Jarak:", " baris 1.70 m (pusat ke pusat) · polybag 625 mm · tanaman 150–200 mm dalam polybag."]]},
{"id": 9, "lines": [["Varietas per baris"]]},
{"id": 10, "lines": [["Baris"], ["Varietas"], ["Polybag · benih"]]},
{"id": 11, "lines": [["A–E"], ["Yellow Kirin Kevin"], ["215 · 430"]]},
{"id": 12, "lines": [["F–G"], ["White Kirin Kevin"], ["86 · 172"]]},
{"id": 13, "lines": [["H–I"], ["Sparmanik Manis Candy (Orange Candy Selection)"], ["86 · 172"]]},
{"id": 14, "lines": [["J"], ["Yellow Kirin Australia F3"], ["43 · 86"]]},
{"id": 15, "lines": [["Sistem ID tanaman"]]},
{"id": 16, "lines": [["Label tiap ", "polybag dengan nomornya saja", " (mis. ", "A12", "). Dua tanaman di dalamnya: ", "Tanaman A", " dan ", "Tanaman B", "→", " ID lengkap ", "A12A", " dan"]]},
{"id": 17, "lines": [["A12B", ". Format: ", "Baris + Nomor + Tanaman", " (A01A, A01B … J48A, J48B)."]]},
{"id": 18, "lines": [["Catatan yang disimpan (per tanaman)"]]},
{"id": 19, "lines": [["Penyerbukan:", " catat tiap silang tangan per tanaman, mis. ", "H18A diserbuki oleh H20B", "."]]},
{"id": 20, "lines": [["Kualitas buah:", " berat, brix, bentuk, jaring kulit, warna kulit, daya simpan, tahan penyakit, hasil."]]},
{"id": 21, "lines": [["Seleksi benih:", " ambil benih hanya dari tanaman terbaik."]]},
{"id": 22, "lines": [["Penyakit:", " laporkan dengan ID tanaman; cek tetangga; catat perlakuannya."]]},
{"id": 23, "lines": [["Bila satu tanaman mati atau sakit"]]},
{"id": 24, "lines": [["Ganti ", "hanya tanaman itu", " (mis. A12B). Tanaman lain (A12A) ", "tetap memakai ID &"], ["catatannya", ". Dua tanaman dalam satu polybag tumbuh berbeda — mencatat masing-masing"]]},
{"id": 25, "lines": [["membantu memilih genetik terbaik dan membuang yang jelek."]]}
]
