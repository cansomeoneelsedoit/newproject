# --- Database ---
# Local dev (docker-compose runs Postgres on host port 5435; the web service
# inside compose uses host `db` on 5432, while running `npm run dev` on the host
# uses `localhost:5435`).
DATABASE_URL="postgresql://kronos:kronos@localhost:5435/kronos?schema=public"

# On Railway, set DATABASE_URL to the Postgres plugin's connection string.
# Railway Postgres requires SSL; the pg client/Prisma handles this automatically
# when ?sslmode=require is appended. Set DATABASE_SSL=false to disable locally.
DATABASE_SSL=false

# --- Auth.js (NextAuth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-prod"
# The canonical app URL. In dev, http://localhost:3004.
AUTH_URL="http://localhost:3004"
# Required behind Railway's proxy in prod.
AUTH_TRUST_HOST=true

# --- File uploads ---
# Path the web app writes uploads to. In dev: ./uploads (default).
# In prod on Railway: mount a Volume at /data and set UPLOAD_DIR=/data/uploads.
UPLOAD_DIR=./uploads

# --- Optional: your own superuser account ---
# The demo login (dev@kronos.local / devpassword) is public and fine for looking
# around. To sign in as yourself, set these and run `npm run db:seed` — the seed
# creates (or updates) a SUPERUSER and makes it an owner of the demo org.
# Keep the real password here in .env, which is gitignored; never in seed.ts,
# because a password committed to a repo stays in its history for good.
# Re-running the seed resets this password, so it doubles as lockout recovery.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# --- Market data ---
# `synthetic` (default) generates deterministic local price series, so Kronos
# runs with no credentials and results reproduce exactly. `stooq` pulls real
# key-free daily bars over the network instead.
MARKET_DATA_PROVIDER=synthetic

# --- Optional: AI analysis ---
# With a key, /instruments/<id> → Analyse calls claude-opus-5. Without one it
# uses the built-in deterministic rule-based writer, so the feature still works.
ANTHROPIC_API_KEY=
# Create a Gemini key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Optional: Google OAuth (sign-in + Calendar) ---
# Redirect URI: http://localhost:3004/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Misc ---
NODE_ENV=development
